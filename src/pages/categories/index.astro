---
import Base from '../../layouts/Base.astro';
import { getDiscoverPosts, SCENES, sceneSlug } from '../../lib/discover';
import { t } from '../../lib/i18n';

const posts = await getDiscoverPosts();
const counts = Object.fromEntries(SCENES.map((s) => [s, posts.filter((p) => p.category === s).length]));
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Categories',
  numberOfItems: SCENES.length,
  itemListElement: SCENES.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s, url: `https://grokbotplays.com/categories/${sceneSlug(s)}/` })),
}];
---
<Base
  title={t('en', 'page.categoriesTitle')}
  description={t('en', 'page.categoriesDesc')}
  nav="categories"
  locale="en"
  chrome="topbar"
  bodyClass="lock-j"
  lockJ
  jsonLd={jsonLd}
  crumbs={[{ name: 'Categories', path: '/categories/' }]}
>
  <div class="discover-head">
    <h1 class="discover-h1">Grok Bot play categories</h1>
    <p class="discover-dek">Five catalog lanes. Seeded from public X posts only.</p>
  </div>
  <ul class="category-list">
    {SCENES.map((s) => (
      <li>
        <a href={`/categories/${sceneSlug(s)}`}>
          <span>{s}</span>
          <span class="category-count">{counts[s]}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
