---
import Base from '../../layouts/Base.astro';
import DiscoverCard from '../../components/DiscoverCard.astro';
import { getDiscoverPosts, SCENES, sceneSlug } from '../../lib/discover';

export async function getStaticPaths() {
  const posts = await getDiscoverPosts();
  return SCENES.map((scene) => ({
    params: { slug: sceneSlug(scene) },
    props: { scene, posts: posts.filter((p) => p.category === scene) },
  }));
}

const { scene, posts } = Astro.props;
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${scene} · Grok Bot Plays`,
  numberOfItems: posts.length,
  itemListElement: posts.slice(0, 50).map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: p.permalink, name: p.title || undefined })),
}];
---
<Base
  title={`${scene} · Plays`}
  description={`Public X posts filed under ${scene}.`}
  nav="categories"
  locale="en"
  chrome="topbar"
  bodyClass="lock-j"
  lockJ
  jsonLd={jsonLd}
  crumbs={[{ name: 'Categories', path: '/categories/' }, { name: scene, path: `/categories/${sceneSlug(scene)}/` }]}
>
  <div class="discover-head">
    <p class="discover-kicker"><a href="/categories">Categories</a> / {scene}</p>
    <h1 class="discover-h1">{scene} Grok Bot plays</h1>
    <p class="discover-dek">{posts.length} posts</p>
  </div>
  <main class="discover-feed">
    {posts.map((p) => <DiscoverCard post={p} />)}
  </main>
</Base>
