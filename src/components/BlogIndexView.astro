---
import Base from '../layouts/Base.astro';
import Mast from './Mast.astro';
import { getPosts, postSlug } from '../lib/blog';
import { t, localePath, otherLocale, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const posts = await getPosts(locale);
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t(locale, 'page.blogTitle'),
  numberOfItems: posts.length,
  itemListElement: posts.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.data.title,
    url: new URL(`${localePath(locale, `/blog/${postSlug(p)}`)}/`, 'https://grokbotplays.com').href,
  })),
}];
---
<Base
  title={t(locale, 'page.blogTitle')}
  description={t(locale, 'page.blogDesc')}
  nav="blog"
  locale={locale}
  chrome={locale === 'en' ? 'topbar' : 'nav'}
  switchHref={localePath(otherLocale(locale), '/blog')}
  alternates={{ en: '/blog/', zh: '/zh/blog/' }}
  jsonLd={jsonLd}
  crumbs={[{ name: locale === 'zh' ? '博客' : 'Blog', path: localePath(locale, '/blog/') }]}
>
  {locale !== 'en' && <Mast locale={locale} tagline="Blog" heading={false} compact />}
  <div class="discover-head discover-feed-head">
    <h1 class="discover-h1">{locale === 'zh' ? 'Grok Bot 博客' : 'Grok Bot Plays blog'}</h1>
  </div>

  {posts.length === 0 ? (
    <p class="empty">{t(locale, 'meta.emptyBlog')}</p>
  ) : (
    <div class="blog-list">
      {posts.map((post) => (
        <a href={localePath(locale, `/blog/${postSlug(post)}`)}>
          {post.data.cover ? (
            <span class="blog-list-shot">
              <img src={post.data.cover} alt={post.data.title} />
            </span>
          ) : null}
          <span class="blog-list-title">{post.data.title}</span>
          <span class="blog-list-dek">{post.data.description}</span>
        </a>
      ))}
    </div>
  )}
</Base>
