---
import Base from '../layouts/Base.astro';
import Mast from './Mast.astro';
import { renderBlogHtml, hasPost, postSlug } from '../lib/blog';
import { PAGE_TITLE } from '../lib/plays';
import { t, localePath, otherLocale, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  post: {
    id: string;
    body?: string;
    data: { title: string; description: string; slug?: string; cover?: string; date?: Date; updated?: Date };
  };
}

const { locale, post } = Astro.props;
const html = renderBlogHtml(post.body || '', locale);
const slug = postSlug(post);
const other = otherLocale(locale);
const otherHas = await hasPost(other, slug);
const switchHref = otherHas
  ? localePath(other, `/blog/${slug}`)
  : localePath(other, '/blog');
const selfPath = `${localePath(locale, `/blog/${slug}`)}/`;
const url = new URL(selfPath, 'https://grokbotplays.com').href;
const articleLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  url,
  mainEntityOfPage: url,
  inLanguage: locale === 'zh' ? 'zh-Hans' : 'en',
  publisher: { '@type': 'Organization', name: 'Grok Bot Plays', url: 'https://grokbotplays.com/' },
};
if (post.data.date) articleLd.datePublished = post.data.date.toISOString().slice(0, 10);
if (post.data.updated) articleLd.dateModified = post.data.updated.toISOString().slice(0, 10);
if (post.data.cover) articleLd.image = new URL(post.data.cover, 'https://grokbotplays.com').href;
const alternates = otherHas ? { en: `/blog/${slug}/`, zh: `/zh/blog/${slug}/` } : undefined;
---
<Base
  title={`${post.data.title} · ${PAGE_TITLE}`}
  description={post.data.description}
  nav="blog"
  locale={locale}
  switchHref={switchHref}
  alternates={alternates}
  jsonLd={[articleLd]}
  crumbs={[{ name: locale === 'zh' ? '博客' : 'Blog', path: localePath(locale, '/blog/') }, { name: post.data.title, path: selfPath }]}
>
  <Mast locale={locale} tagline="Blog" heading={false} compact />

  <article class="post">
    <a class="back" href={localePath(locale, '/blog')}>{t(locale, 'blog.back')}</a>
    {post.data.cover && (
      <div class="post-cover">
        <img src={post.data.cover} alt={post.data.title} />
      </div>
    )}
    <h1 class="detail-title">{post.data.title}</h1>
    <Fragment set:html={html} />
    <p class="note">
      <a class="source-link" href={localePath(locale, '/install')}>{t(locale, 'nav.install')}</a>
      {' · '}
      <a class="source-link" href={localePath(locale, '/')}>{t(locale, 'nav.catalog')}</a>
    </p>
  </article>
</Base>
