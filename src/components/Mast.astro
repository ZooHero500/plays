---
import { t, type Locale } from '../lib/i18n';
import BloubFace from './BloubFace.astro';

interface Props {
  tagline?: string;
  heading?: boolean;
  locale: Locale;
  bot?: boolean;
  compact?: boolean;
  dek?: boolean;
}

const { tagline = 'nav', heading = true, locale, bot = false, compact = false, dek = false } = Astro.props;
const Word = heading ? 'h1' : 'p';
const line = !tagline || tagline === 'nav' ? t(locale, 'mast.tagline') : tagline;
---
<header class:list={['mast', { 'mast-compact': compact }]}>
  <div class="mast-row">
    <Word class="wordmark">Plays</Word>
    {bot && <BloubFace />}
  </div>
  <p class="tagline">{line}</p>
  {dek && <p class="mast-dek">{t(locale, 'mast.dek')}</p>}
</header>
