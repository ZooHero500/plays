---
import Base from '../layouts/Base.astro';
import {
  allGuidePlayIds,
  assertGuidePlayCaps,
  guidePath,
  loadGuidePlays,
  type GuideDef,
  type GuideSlug,
} from '../lib/guides';
import type { ParsedGuide } from '../lib/guide-md';
import type { PlayData } from '../lib/plays';

interface Props {
  guide: GuideDef;
  doc: ParsedGuide;
}

const { guide, doc } = Astro.props;
assertGuidePlayCaps(guide);

const playIds = [...new Set([...allGuidePlayIds(guide), ...doc.blocks.flatMap((b) =>
  b.type === 'picks' ? b.items.map((p) => p.id) : [],
)])];
const loaded = await loadGuidePlays(playIds);
const byId = new Map(loaded.map((p) => [p.id, p]));

function playOf(id: string): PlayData | undefined {
  return byId.get(id);
}

const origin = Astro.site ? String(Astro.site).replace(/\/$/, '') : 'https://grokbotplays.com';
const pageUrl = `${origin}${guidePath(guide.slug)}`;
const guidesUrl = `${origin}/guides/`;
const homeUrl = `${origin}/`;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: doc.fm.title,
  name: doc.fm.metaTitle,
  description: doc.fm.metaDescription,
  inLanguage: 'en',
  datePublished: doc.fm.published,
  mainEntityOfPage: pageUrl,
  url: pageUrl,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: guidesUrl },
    { '@type': 'ListItem', position: 3, name: guide.crumb, item: pageUrl },
  ],
};

const nextLinks = doc.blocks.find((b) => b.type === 'next');
const related = nextLinks && nextLinks.type === 'next'
  ? nextLinks.links.filter((l) => l.href.startsWith('/guides/'))
  : [];
const ctaSubs = nextLinks && nextLinks.type === 'next'
  ? nextLinks.links.filter((l) => !l.href.startsWith('/guides/') && l.href !== '/')
  : [];

const otherLabel: Record<GuideSlug, string> = {
  'how-to-use-grok-bot': 'How to use Grok Bot',
  'grok-bot-templates': 'Grok Bot templates',
  'grok-bot-use-cases': 'Use cases',
};
---
<Base
  title={doc.fm.metaTitle}
  description={doc.fm.metaDescription}
  nav="guides"
  locale="en"
  chrome="topbar"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <article class="guide-page" data-guide-page={guide.slug}>
    <nav class="guide-crumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span>
      <a href="/guides/">Guides</a><span>/</span>
      {guide.crumb}
    </nav>

    <p class="guide-kicker">{guide.kicker}</p>
    <h1 class="guide-h1">{doc.fm.title}</h1>
    <div class="guide-lede" set:html={doc.ledeHtml} />

    {doc.blocks.map((block) => {
      if (block.type === 'h2') {
        return <h2 class="guide-h2">{block.text}</h2>;
      }
      if (block.type === 'h3') {
        return <h3 class="guide-h3">{block.text}</h3>;
      }
      if (block.type === 'prose') {
        return <div class="guide-prose" set:html={block.html} />;
      }
      if (block.type === 'ul') {
        return (
          <ul class="guide-ul">
            {block.items.map((item) => <li set:html={item} />)}
          </ul>
        );
      }
      if (block.type === 'steps') {
        return (
          <ol class="guide-steps">
            {block.items.map((step, idx) => (
              <li>
                <span class="n">{String(idx + 1).padStart(2, '0')}</span>
                <div>
                  {step.title ? <strong>{step.title}</strong> : null}
                  <p set:html={step.body} />
                </div>
              </li>
            ))}
          </ol>
        );
      }
      if (block.type === 'picks') {
        return (
          <div class="guide-picks-wrap">
            {block.more && (
              <p class="guide-picks-more">
                <a href={block.more.href}>{block.more.label}</a>
              </p>
            )}
            <div class="guide-picks" data-guide-section={block.section}>
              {block.items.map((item) => {
                const play = playOf(item.id);
                return (
                  <a
                    class="guide-pick"
                    href={`/play/${item.id}`}
                    data-guide-play={item.id}
                    data-guide-section={block.section}
                  >
                    <div class="thumb" aria-hidden="true">Play</div>
                    <div>
                      <p class="title">{play?.title || item.id}</p>
                      <p class="why">{item.why}</p>
                    </div>
                    <span class="go">Open →</span>
                  </a>
                );
              })}
            </div>
          </div>
        );
      }
      if (block.type === 'faq') {
        return (
          <div class="guide-faq">
            {block.items.map((item, idx) => (
              <details open={idx === 0}>
                <summary>{item.q}</summary>
                <p set:html={item.a} />
              </details>
            ))}
          </div>
        );
      }
      return null;
    })}

    <div class="guide-related">
      {(related.length
        ? related
        : (['how-to-use-grok-bot', 'grok-bot-templates', 'grok-bot-use-cases'] as GuideSlug[])
            .filter((slug) => slug !== guide.slug)
            .map((slug) => ({ href: guidePath(slug), label: otherLabel[slug] }))
      ).map((l) => (
        <a class="guide-chip" href={l.href}>{l.label}</a>
      ))}
    </div>

    <div class="guide-cta">
      <p>Ready to browse more plays?</p>
      <a class="guide-btn" href="/">Back to Plays</a>
      {ctaSubs.length > 0 && (
        <span class="sub">
          {ctaSubs.map((l, i) => (
            <>
              {i > 0 && ' · '}
              <a href={l.href}>{l.label}</a>
            </>
          ))}
        </span>
      )}
    </div>
  </article>
</Base>
